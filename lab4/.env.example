# Скопируйте в .env и задайте собственные пароли. Файл .env не коммитится.

# Суперпользователь PostgreSQL (используется только контейнером при инициализации)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser

# Подключение к БД
DB_HOST=localhost
DB_PORT=5432
DB_NAME=museum

# Владелец схемы: выполняет миграции Flyway (DDL)
DB_OWNER_USER=museum_owner
DB_OWNER_PASSWORD=change-me-owner

# Пользователь приложения: только SELECT/INSERT/UPDATE/DELETE
DB_APP_USER=museum_app
DB_APP_PASSWORD=change-me-app

# Первый администратор: создаётся при старте, если в БД ещё нет администратора.
# Пароль должен соответствовать политике (не короче 12 символов, буквы разного регистра, цифры, спецсимволы).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@museum.example
ADMIN_PASSWORD=Change-Me-Str0ng#Key
